+void Sensors::reset_airspeed_quality_input(uint8_t reason)
+{
+	_quality_rate_prev_timestamp = 0;
+	_quality_measured_source_rate_hz = NAN;
+	_quality_rate_sample_count = 0;
+	_quality_rate_valid = false;
